# Copy to .env for local runs. Never put real tokens, mailbox addresses, or calendar ids in git.
# Runtime files (SQLite, backups, Google credential JSON) stay under TAFO_DATA_DIR or an absolute path outside the repo.

TAFO_HOST=127.0.0.1
TAFO_PORT=8787
TAFO_DATA_DIR=./data
TAFO_DB_PATH=
TAFO_DISPLAY_TIMEZONE=America/Indianapolis
TAFO_CALENDAR_MODE=demo
TAFO_GOOGLE_CREDENTIALS_FILE=
TAFO_GOOGLE_CALENDAR_ID=
TAFO_WORK_INVITE_EMAIL=
TAFO_ALLOW_LAN=0
TAFO_SEED_DEMO=1
